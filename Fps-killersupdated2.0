-- TELEGUIADO (AGREGADO SIN MODIFICAR NADA MÁS)
flyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    flyBtn.Text = flying and "TELEGUIADO ON" or "TELEGUIADO OFF"
    flyBtn.BackgroundColor3 = flying and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(50, 0, 0)
    if flying then
        spawn(function()
            while flying and root do
                root.Velocity = camera.CFrame.LookVector * flySpeed
                task.wait()
            end
        end)
    else
        root.Velocity = Vector3.new(0,0,0)
    end
end)

-- CONEXIÓN DE CAMBIO DE PERSONAJE
LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    char = newCharacter
    root = char:WaitForChild("HumanoidRootPart")
    
    newCharacter:WaitForChild("Humanoid")
    task.wait(0.2)
    
    local humanoid = newCharacter:FindFirstChild("Humanoid")
    if humanoid then
        originalWalkSpeed = humanoid.WalkSpeed
    end
    
    applyAnimationBlock(newCharacter)
    restoreAnimationBlock(newCharacter)
    
    if isWalkBlocked then
        applyAnimationBlock(newCharacter)
    end
    
    if speedBoostActive then
        task.wait(0.5)
        applySpeedBoost()
    end
end)

